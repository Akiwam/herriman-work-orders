{
  "_about": "Proposed data model, derived from the requirements in the STORY-000 brief. A starting point for review — no table has been created. Edit this file to change what the Data model tab shows.",
  "status": "Proposed — not created yet",
  "note": "Review this before any table is created. Tables are named for what is stored; external systems (GIS, the utility locate service, Lama, Sprypoint, Madison AI) appear as rows in integration_endpoint, not as tables of their own.",
  "entities": [
    {
      "name": "work_order",
      "purpose": "A piece of maintenance work, from creation through completion.",
      "requirements": [
        "REQ-001",
        "REQ-002",
        "REQ-032",
        "REQ-051"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "number",
          "type": "text",
          "note": "human-readable, unique"
        },
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "description",
          "type": "text"
        },
        {
          "name": "work_type",
          "type": "text",
          "note": "used for heat maps by type (REQ-031)"
        },
        {
          "name": "priority",
          "type": "text"
        },
        {
          "name": "status",
          "type": "text",
          "note": "open or completed; the workflow step is in current_step"
        },
        {
          "name": "workflow_id",
          "type": "uuid",
          "note": "→ workflow"
        },
        {
          "name": "current_step",
          "type": "text",
          "note": "its step in that workflow version"
        },
        {
          "name": "step_entered_at",
          "type": "timestamp"
        },
        {
          "name": "location_text",
          "type": "text",
          "note": "freeform location when GIS has none (REQ-032)"
        },
        {
          "name": "latitude",
          "type": "numeric"
        },
        {
          "name": "longitude",
          "type": "numeric"
        },
        {
          "name": "is_public",
          "type": "boolean",
          "note": "visible on the public activity view (REQ-037)"
        },
        {
          "name": "created_by",
          "type": "uuid",
          "note": "→ app_user"
        },
        {
          "name": "assigned_to",
          "type": "uuid",
          "note": "→ app_user"
        },
        {
          "name": "created_at",
          "type": "timestamptz"
        },
        {
          "name": "updated_at",
          "type": "timestamptz"
        },
        {
          "name": "completed_at",
          "type": "timestamptz"
        },
        {
          "name": "completion_note",
          "type": "text"
        }
      ],
      "relationships": [
        {
          "type": "many-to-many",
          "to": "asset",
          "via": "work_order_asset"
        },
        {
          "type": "belongs to",
          "to": "workflow",
          "via": "workflow_id"
        },
        {
          "type": "has many",
          "to": "audit_entry",
          "via": "entity_id"
        }
      ]
    },
    {
      "name": "asset",
      "purpose": "A physical asset mirrored from the primary GIS database.",
      "requirements": [
        "REQ-023",
        "REQ-026"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "gis_feature_id",
          "type": "text",
          "note": "id in the GIS database, unique"
        },
        {
          "name": "asset_type",
          "type": "text"
        },
        {
          "name": "name",
          "type": "text"
        },
        {
          "name": "attributes",
          "type": "jsonb",
          "note": "fields that autofill a work order"
        },
        {
          "name": "geometry",
          "type": "geometry"
        },
        {
          "name": "last_synced_at",
          "type": "timestamptz"
        }
      ],
      "relationships": [
        {
          "type": "many-to-many",
          "to": "work_order",
          "via": "work_order_asset"
        },
        {
          "type": "has many",
          "to": "gis_sync_event",
          "via": "asset_id"
        }
      ]
    },
    {
      "name": "work_order_asset",
      "purpose": "Links the assets selected on the map to a work order.",
      "requirements": [
        "REQ-023"
      ],
      "fields": [
        {
          "name": "work_order_id",
          "type": "uuid",
          "note": "→ work_order"
        },
        {
          "name": "asset_id",
          "type": "uuid",
          "note": "→ asset"
        },
        {
          "name": "selected_at",
          "type": "timestamptz"
        }
      ],
      "relationships": [
        {
          "type": "belongs to",
          "to": "work_order",
          "via": "work_order_id"
        },
        {
          "type": "belongs to",
          "to": "asset",
          "via": "asset_id"
        }
      ]
    },
    {
      "name": "gis_sync_event",
      "purpose": "Every read from and write to the GIS database, so two-way sync can be audited and retried.",
      "requirements": [
        "REQ-026"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "direction",
          "type": "text",
          "note": "read | write"
        },
        {
          "name": "asset_id",
          "type": "uuid",
          "note": "→ asset"
        },
        {
          "name": "work_order_id",
          "type": "uuid",
          "note": "→ work_order, nullable"
        },
        {
          "name": "idempotency_key",
          "type": "text",
          "note": "unique, so a retry never writes twice"
        },
        {
          "name": "status",
          "type": "text",
          "note": "ok | failed"
        },
        {
          "name": "error",
          "type": "text"
        },
        {
          "name": "occurred_at",
          "type": "timestamptz"
        }
      ],
      "relationships": [
        {
          "type": "belongs to",
          "to": "asset",
          "via": "asset_id"
        }
      ]
    },
    {
      "name": "service_request",
      "purpose": "A request a resident submits on the public site; each one creates a work order. BUILT as the service_requests table, with every submission attempt in public_submission_log.",
      "requirements": [
        "REQ-037"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "tracking_code",
          "type": "text",
          "note": "given to the citizen, unique, e.g. HWO-7K2P9Q"
        },
        {
          "name": "submission_id",
          "type": "text",
          "note": "unique; the same submission sent twice makes one request"
        },
        {
          "name": "description",
          "type": "text"
        },
        {
          "name": "category",
          "type": "text"
        },
        {
          "name": "location_text",
          "type": "text"
        },
        {
          "name": "latitude",
          "type": "numeric"
        },
        {
          "name": "longitude",
          "type": "numeric"
        },
        {
          "name": "contact",
          "type": "text",
          "note": "optional; never shown publicly or sent to outside systems"
        },
        {
          "name": "work_order_id",
          "type": "uuid",
          "note": "→ work_order"
        },
        {
          "name": "submitted_at",
          "type": "timestamptz"
        }
      ],
      "relationships": [
        {
          "type": "becomes",
          "to": "work_order",
          "via": "work_order_id"
        }
      ]
    },
    {
      "name": "locate_ticket",
      "purpose": "A utility locate ticket from the one-call centre, updated, answered and completed inside the platform. BUILT as the locate_tickets table, with responses queued in bluestakes_outbox.",
      "requirements": [
        "REQ-039"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "ticket_number",
          "type": "text",
          "note": "the one-call centre's number, unique"
        },
        {
          "name": "ticket_type",
          "type": "text",
          "note": "normal | emergency"
        },
        {
          "name": "status",
          "type": "text",
          "note": "received | in_progress | responded | completed"
        },
        {
          "name": "excavator_name",
          "type": "text"
        },
        {
          "name": "work_description",
          "type": "text"
        },
        {
          "name": "dig_address",
          "type": "text"
        },
        {
          "name": "latitude",
          "type": "numeric"
        },
        {
          "name": "longitude",
          "type": "numeric"
        },
        {
          "name": "received_at",
          "type": "timestamptz"
        },
        {
          "name": "due_at",
          "type": "timestamptz",
          "note": "when the response is due"
        },
        {
          "name": "locator_notes",
          "type": "text"
        },
        {
          "name": "marking_details",
          "type": "text"
        },
        {
          "name": "work_order_id",
          "type": "uuid",
          "note": "→ work_order, nullable"
        },
        {
          "name": "response_code",
          "type": "text",
          "note": "PLACEHOLDER codes until the official list is known"
        },
        {
          "name": "response_note",
          "type": "text"
        },
        {
          "name": "responded_at",
          "type": "timestamptz"
        },
        {
          "name": "completed_at",
          "type": "timestamptz"
        },
        {
          "name": "created_at",
          "type": "timestamptz"
        },
        {
          "name": "updated_at",
          "type": "timestamptz"
        }
      ],
      "relationships": [
        {
          "type": "belongs to",
          "to": "work_order",
          "via": "work_order_id"
        }
      ]
    },
    {
      "name": "workflow",
      "purpose": "A configurable sequence of steps for one work type, kept in versions, so existing workflows keep working and new ones can be added. Built as the workflows table; a built-in Standard workflow covers every work type without its own.",
      "requirements": [
        "REQ-045"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key; one row per version"
        },
        {
          "name": "workflow_key",
          "type": "text",
          "note": "the same across versions"
        },
        {
          "name": "version",
          "type": "integer"
        },
        {
          "name": "name",
          "type": "text"
        },
        {
          "name": "work_type",
          "type": "text",
          "note": "null only for Standard"
        },
        {
          "name": "status",
          "type": "text",
          "note": "active | superseded | retired"
        },
        {
          "name": "definition_sha256",
          "type": "text",
          "note": "confirms it was saved as sent"
        },
        {
          "name": "created_by",
          "type": "text"
        },
        {
          "name": "created_at",
          "type": "timestamp"
        }
      ],
      "relationships": [
        {
          "type": "has many",
          "to": "workflow_step",
          "via": "workflow_id"
        },
        {
          "type": "has many",
          "to": "work_order",
          "via": "workflow_id"
        }
      ]
    },
    {
      "name": "workflow_step",
      "purpose": "One step of a workflow version, with the steps it may move to. Built as the workflow_steps table.",
      "requirements": [
        "REQ-045"
      ],
      "fields": [
        {
          "name": "workflow_id",
          "type": "uuid",
          "note": "→ workflow"
        },
        {
          "name": "step_key",
          "type": "text"
        },
        {
          "name": "position",
          "type": "integer",
          "note": "1 = where work orders start"
        },
        {
          "name": "name",
          "type": "text"
        },
        {
          "name": "is_final",
          "type": "boolean",
          "note": "reaching it completes the work order"
        },
        {
          "name": "next_steps_json",
          "type": "json",
          "note": "step keys it may move to"
        },
        {
          "name": "required_role",
          "type": "text",
          "note": "→ role, nullable; not enforced until roles exist"
        }
      ],
      "relationships": [
        {
          "type": "belongs to",
          "to": "workflow",
          "via": "workflow_id"
        }
      ]
    },
    {
      "name": "app_user",
      "purpose": "A member of city staff who uses the system with a personal key. Built as the users table.",
      "requirements": [
        "REQ-047"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "email",
          "type": "text",
          "note": "unique, lower-case"
        },
        {
          "name": "display_name",
          "type": "text"
        },
        {
          "name": "is_active",
          "type": "boolean",
          "note": "deactivating removes the personal key"
        },
        {
          "name": "key_prefix",
          "type": "text",
          "note": "of the personal key; the key itself is never stored"
        },
        {
          "name": "key_hash",
          "type": "text",
          "note": "sha256 of the personal key"
        },
        {
          "name": "created_by",
          "type": "text",
          "note": "→ app_user, or system for the first administrator"
        },
        {
          "name": "created_at",
          "type": "timestamptz"
        },
        {
          "name": "version",
          "type": "integer",
          "note": "+1 on every change; for If-Match"
        }
      ],
      "relationships": [
        {
          "type": "many-to-many",
          "to": "role",
          "via": "user_role"
        }
      ]
    },
    {
      "name": "role",
      "purpose": "A named set of permissions (the same names API client scopes use). Built as the roles table: six placeholder built-in roles that cannot be edited, plus roles the city defines.",
      "requirements": [
        "REQ-047"
      ],
      "fields": [
        {
          "name": "id",
          "type": "text",
          "note": "primary key, e.g. field_crew"
        },
        {
          "name": "name",
          "type": "text",
          "note": "unique"
        },
        {
          "name": "description",
          "type": "text"
        },
        {
          "name": "permissions",
          "type": "jsonb",
          "note": "stored as permissions_json"
        },
        {
          "name": "is_builtin",
          "type": "boolean"
        }
      ],
      "relationships": [
        {
          "type": "many-to-many",
          "to": "app_user",
          "via": "user_role"
        }
      ]
    },
    {
      "name": "user_role",
      "purpose": "Which users hold which roles. Built as the user_roles table; every grant and removal is in the audit trail.",
      "requirements": [
        "REQ-047"
      ],
      "fields": [
        {
          "name": "user_id",
          "type": "uuid",
          "note": "→ app_user"
        },
        {
          "name": "role_id",
          "type": "uuid",
          "note": "→ role"
        },
        {
          "name": "granted_by",
          "type": "uuid",
          "note": "→ app_user"
        },
        {
          "name": "granted_at",
          "type": "timestamptz"
        }
      ],
      "relationships": [
        {
          "type": "belongs to",
          "to": "app_user",
          "via": "user_id"
        },
        {
          "type": "belongs to",
          "to": "role",
          "via": "role_id"
        }
      ]
    },
    {
      "name": "audit_entry",
      "purpose": "An append-only record of every change, read and refused access, with who and when. Built as audit_entries; auditors read it through the API.",
      "requirements": [
        "REQ-047",
        "REQ-051"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "actor_user_id",
          "type": "uuid",
          "note": "→ app_user; the verified user, null for outside systems and the first setup"
        },
        {
          "name": "actor",
          "type": "text",
          "note": "readable: an email, or \"name via system\""
        },
        {
          "name": "entity_type",
          "type": "text"
        },
        {
          "name": "entity_id",
          "type": "uuid"
        },
        {
          "name": "action",
          "type": "text",
          "note": "e.g. create | update | complete | transition | grant | revoke | read | denied"
        },
        {
          "name": "before",
          "type": "jsonb"
        },
        {
          "name": "after",
          "type": "jsonb"
        },
        {
          "name": "occurred_at",
          "type": "timestamptz"
        }
      ],
      "relationships": [
        {
          "type": "belongs to",
          "to": "app_user",
          "via": "actor_user_id"
        }
      ]
    },
    {
      "name": "system_setting",
      "purpose": "A configuration value administrators can change, with who changed it. Built as the system_settings table; which settings exist, with their ranges and defaults, is defined in code. Never holds secrets.",
      "requirements": [
        "REQ-047"
      ],
      "fields": [
        {
          "name": "key",
          "type": "text",
          "note": "primary key, e.g. public.rate_limit_per_hour"
        },
        {
          "name": "value",
          "type": "jsonb",
          "note": "stored as value_json; null means the default"
        },
        {
          "name": "version",
          "type": "integer",
          "note": "+1 on every change"
        },
        {
          "name": "updated_by",
          "type": "uuid",
          "note": "→ app_user"
        },
        {
          "name": "updated_at",
          "type": "timestamptz"
        }
      ],
      "relationships": [
        {
          "type": "belongs to",
          "to": "app_user",
          "via": "updated_by"
        }
      ]
    },
    {
      "name": "integration_endpoint",
      "purpose": "One external system this connects to, with the last time its connection was checked.",
      "requirements": [
        "REQ-038",
        "REQ-040",
        "REQ-054",
        "REQ-055"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "name",
          "type": "text",
          "note": "e.g. GIS, locate service, Lama, Sprypoint, Madison AI"
        },
        {
          "name": "direction",
          "type": "text",
          "note": "inbound | outbound | both"
        },
        {
          "name": "base_url",
          "type": "text"
        },
        {
          "name": "status",
          "type": "text",
          "note": "connected | not_connected | error"
        },
        {
          "name": "last_checked_at",
          "type": "timestamptz"
        },
        {
          "name": "last_error",
          "type": "text"
        }
      ],
      "relationships": [
        {
          "type": "has many",
          "to": "api_client",
          "via": "integration_endpoint_id"
        }
      ]
    },
    {
      "name": "api_client",
      "purpose": "A credentialed client allowed to read work order data through the open API, such as a search indexer.",
      "requirements": [
        "REQ-040"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "integration_endpoint_id",
          "type": "uuid",
          "note": "→ integration_endpoint"
        },
        {
          "name": "scopes",
          "type": "text[]"
        },
        {
          "name": "secret_hash",
          "type": "text",
          "note": "hash only, never the secret"
        },
        {
          "name": "revoked_at",
          "type": "timestamptz"
        }
      ],
      "relationships": [
        {
          "type": "belongs to",
          "to": "integration_endpoint",
          "via": "integration_endpoint_id"
        }
      ]
    },
    {
      "name": "compliance_response",
      "purpose": "A vendor's compliance answer and technical approach for one requirement, with review. BUILT as vendor_submissions (one row per revision) and vendor_documents.",
      "requirements": [
        "REQ-022"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "vendor_id",
          "type": "text",
          "note": "the vendor's API client"
        },
        {
          "name": "vendor_name",
          "type": "text"
        },
        {
          "name": "requirement_id",
          "type": "text",
          "note": "from server/vendor/requirements.json, e.g. REQ-023"
        },
        {
          "name": "revision",
          "type": "integer",
          "note": "1, 2, … per vendor and requirement"
        },
        {
          "name": "compliance",
          "type": "text",
          "note": "complies | partially_complies | does_not_comply"
        },
        {
          "name": "technical_approach",
          "type": "text"
        },
        {
          "name": "content_sha256",
          "type": "text",
          "note": "fingerprint of the answer, approach and every document"
        },
        {
          "name": "status",
          "type": "text",
          "note": "submitted | approved | changes_requested"
        },
        {
          "name": "submitted_at",
          "type": "timestamptz"
        },
        {
          "name": "reviewed_by",
          "type": "text"
        },
        {
          "name": "reviewed_at",
          "type": "timestamptz"
        },
        {
          "name": "review_comment",
          "type": "text",
          "note": "required when changes are requested"
        }
      ],
      "relationships": [
        {
          "type": "has many",
          "to": "vendor_document",
          "via": "submission_id"
        }
      ]
    },
    {
      "name": "readiness_item",
      "purpose": "One configuration, testing or data-conversion task on the way to go-live.",
      "requirements": [
        "REQ-052",
        "REQ-053"
      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "category",
          "type": "text",
          "note": "configuration | testing | data conversion"
        },
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "status",
          "type": "text"
        },
        {
          "name": "due_on",
          "type": "date"
        },
        {
          "name": "completed_on",
          "type": "date"
        }
      ],
      "relationships": []
    }
  ]
}
