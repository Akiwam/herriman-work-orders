      ],
      "fields": [
        {
          "name": "id",
          "type": "uuid",
          "note": "primary key"
        },
        {
          "name": "category",
          "type": "text",
          "note": "configuration | testing | data conversion"
        },
        {
          "name": "title",
          "type": "text"
        },
        {
          "name": "status",
          "type": "text"
        },
        {
          "name": "due_on",
          "type": "date"
        },
        {
          "name": "completed_on",
          "type": "date"
        }
      ],
      "relationships": []
    }
  ]
}
