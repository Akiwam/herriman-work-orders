{
  "name": "herriman-command-center",
  "private": true,
  "type": "module",
  "description": "Command Center for the Herriman City Work Order Management build. Static site, no build step.",
  "scripts": {
    "test": "node --test",
    "serve": "python -m http.server 8000",
    "demo": "node --no-warnings server/demo.js",
    "demo:api": "node --no-warnings server/api/demo.js",
    "demo:tickets": "node --no-warnings server/bluestakes/demo.js",
    "demo:public": "node --no-warnings server/public/demo.js",
    "public": "node --no-warnings server/public/serve.js"
  }
}
